# Server-side settings for compose.yaml. vps-setup.sh app-config copies this to .env ON THE SERVER once;
# edit the real values there (ssh in, then: nano /opt/<app>/.env). Never commit real secrets.
APP_NAME=my-app
# the DNS A record of DOMAIN must point at this server
DOMAIN=app.example.com
# the port your app listens on inside the container
APP_PORT=8080
APP_MEM_LIMIT=512m

# Your app's own settings and secrets, for example:
# DATABASE_URL=postgres://user:CHANGE_ME@db.example.com:5432/app
# SECRET_KEY=CHANGE_ME
