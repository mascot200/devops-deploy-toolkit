# deploy/targets.example.env
# Copy to deploy/targets.staging.env and deploy/targets.production.env and edit.
# The real files are git-ignored. NEVER put passwords, tokens or private keys here:
# credentials come from your SSH agent, `aws sso login` / OIDC, and `kubectl` contexts.

# --- common -------------------------------------------------------------
APP_NAME=shop-api
IMAGE=ghcr.io/your-org/shop-api            # image repository, without a tag
HEALTH_URL=https://staging.example.com/healthz

# --- target: Docker Compose on a VPS (skill: deploy-compose-vps) --------
VPS_HOST=203.0.113.10
VPS_USER=deploy
VPS_APP_DIR=/opt/shop-api                  # contains compose.yaml and .env on the server
COMPOSE_FILE=compose.yaml                  # must use image: ${IMAGE}:${IMAGE_TAG}
AUTO_ROLLBACK=0                            # 1 = roll back automatically if the health check fails

# --- target: AWS with Terraform (skill: deploy-terraform-aws) -----------
TF_DIR=infra/envs/staging                  # the root module for this environment
TF_VAR_FILE=staging.tfvars                 # relative to TF_DIR (optional)

# --- target: Kubernetes with Helm (skill: deploy-helm-k8s) --------------
KUBE_CONTEXT=kind-staging
K8S_NAMESPACE=shop
HELM_RELEASE=shop-api
HELM_CHART=charts/shop-api
HELM_VALUES=charts/shop-api/values-staging.yaml

# --- target: GitOps with Argo CD (skill: deploy-gitops-argocd) ----------
GITOPS_REPO_DIR=../shop-gitops             # local clone of the GitOps repository
GITOPS_OVERLAY_PATH=apps/shop-api/overlays/staging   # a kustomize overlay directory
GITOPS_BASE_BRANCH=main
ARGOCD_APP=shop-api-staging
